[req]
distinguished_name = dn
x509_extensions = v3
prompt = no
[dn]
CN = privacy-check.local
O = Privacy Check (local)
[v3]
subjectAltName = @alt
basicConstraints = CA:FALSE
keyUsage = digitalSignature, keyEncipherment
extendedKeyUsage = serverAuth
[alt]
DNS.1 = localhost
DNS.2 = KQRJK69V4N.local
IP.1 = 127.0.0.1
IP.2 = 10.8.1.2
